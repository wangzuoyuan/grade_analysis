# 合并版入口反代（候选）：/api → backend，其余 → frontend。
# 端口由 docker-compose.yml 的 CADDY_PORT 占位控制（候选 8081），
# 不占用旧站 8080；上线当天以 check-ports.sh 实测为准。
#
# 两个入口（2026-10-18 内网免登恢复）：
# - :8080 公网入口（宿主 CADDY_PORT，路由器转发）：登录鉴权按后端默认执行；
#   显式删除客户端伪造的 X-Lan-Bypass-Token 头（同名头只允许 :8090 注入）。
# - :8090 内网入口（宿主 LAN_PORT）：与公网同构，/api 额外注入
#   X-Lan-Bypass-Token: {env.AUTH_LAN_BYPASS_TOKEN}（密钥与后端同名 env
#   同源于 backend.env）。后端凭密钥免登录——Docker Desktop 发布端口会把所有
#   来源改写成网桥网关 IP，公网/内网在 IP 层不可区分，故用密钥而非网段判定。
#   注意：勿在路由器上映射 8090，该端口只应局域网可达。
:8080 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000 {
			# DSM terminates HTTPS; preserve its scheme for Secure session cookies.
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up -X-Lan-Bypass-Token
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}

:8090 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Lan-Bypass-Token {env.AUTH_LAN_BYPASS_TOKEN}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
