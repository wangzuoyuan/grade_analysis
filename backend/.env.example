# 复制本文件为 .env，填入你的 API Key 后再启动应用

# === Anthropic 模式（默认） ===
CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=              # 留空使用官方地址；填兼容服务地址可切换第三方
ANTHROPIC_MODEL=claude-sonnet-4-6

# === OpenAI 兼容模式 ===
# CHAT_PROVIDER=openai
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=              # 留空使用 api.openai.com；填兼容服务地址（含 /v1）
# OPENAI_MODEL=gpt-4o-mini

# === Docker / NAS 公网部署才需要；本地开发可全部留空 ===
# APP_PASSWORD：设了它才启用登录。2026-10 安全修复后：设了密码默认**所有入口**都要求登录
# （绝不看 Host 头）。建议设强密码；浏览器登录一次后 Cookie 有效 30 天。
APP_PASSWORD=
# PUBLIC_HOST：旧配置项，已不参与鉴权决策（保留仅为兼容不报错），可留空。
PUBLIC_HOST=
# 内网免登录（可选，必须显式配置网络边界，默认不配=全入口需登录）：
# AUTH_TRUSTED_PROXY_NETWORKS：直连对端 IP（如 caddy 容器网段）命中才信任 X-Forwarded-For；
# AUTH_BYPASS_NETWORKS：解出的有效客户端 IP 命中该网段才免登录。未配信任代理时伪造转发头完全无效。
# AUTH_TRUSTED_PROXY_NETWORKS=172.18.0.0/16
# AUTH_BYPASS_NETWORKS=192.168.1.0/24
# AUTH_LAN_BYPASS_TOKEN：内网免登密钥（deploy 部署专用）。由 caddy 的 :8090 内网入口
# 注入 X-Lan-Bypass-Token 头（与 deploy/backend.env 同一条目；Docker 发布端口会把所有
# 来源改写成网桥 IP，公网/内网在 IP 层不可区分，故用密钥判定）。openssl rand -hex 32 生成。
# AUTH_LAN_BYPASS_TOKEN=
# SESSION_SECRET：会话签名密钥，留空则自动在数据目录生成并持久化（推荐留空）。
SESSION_SECRET=
# EXAM_TRACKER_DIR / EXAM_TRACKER_BACKUP_DIR：数据目录。Docker 镜像已默认 /data，本地通常无需设置。
# CORS_ORIGINS：同源部署无需设置；如需额外放行来源用逗号分隔。

# === 只读 MCP 服务端（供笔记本 Hermes 等经公网 HTTPS 调用；详见 DEPLOY.md） ===
# MCP_ENABLED：默认 false（不挂载 /mcp，应用行为与之前完全一致）。
MCP_ENABLED=
# MCP_BEARER_TOKEN：启用 MCP 时必填。缺失/空白/弱占位符/短于 32 字符会让后端启动失败。
# 生成方式：openssl rand -hex 32（只在终端生成，不要把真实值提交进仓库或日志）。
# 班主任版与任课教师版（教学版）各自独立 token，不要共用。
MCP_BEARER_TOKEN=
# MCP_ALLOWED_HOSTS：允许的 Host 头（逗号分隔）。缺省仅 localhost（测试用）。
# 公网部署必须显式加你的域名，例如：grade.zuoyuan.wang,grade.zuoyuan.wang:*
MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS：允许的 Origin（逗号分隔）。缺省仅 localhost。
# 非浏览器客户端（Hermes/curl）不带 Origin 头，天然放行；浏览器跨域访问才需要配。
MCP_ALLOWED_ORIGINS=
